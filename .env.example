# CognoDB / Neo4j Bolt Connection Settings
# Supported URI schemes: bolt://, neo4j://, neo4j+s://, bolt+s://
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Alternative CognoDB variable naming (both are supported by src/lib/neo4j.ts)
COGNODB_URI=
COGNODB_USER=
COGNODB_PASSWORD=
